# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 .gitignore 대상입니다.

# --- GitHub (코드 permalink / 런북 링크) ---
GITHUB_OWNER=your-github-id
GITHUB_REPO=n8n-alert-lab

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
APP_DB_PASSWORD=change-me-app
DIAG_DB_PASSWORD=change-me-diag
OPS_DB_PASSWORD=change-me-ops

# --- Slack Incoming Webhook ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- LLM (OpenAI 호환 Chat Completions API) ---
# 제공자를 바꿀 때는 아래 4줄만 바꾸면 된다.
# 변수 이름을 OPENAI_* 로 두지 않는 이유: PC 환경변수에 같은 이름이 있으면 docker compose 가 .env 보다 우선 적용함
#
# Google Gemini (무료 등급 가능 — 단, 무료 등급 입력은 모델 개선에 쓰일 수 있음)
LLM_API_KEY=your-gemini-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash
# 추론 강도: none | low | medium | high. 추론 토큰도 출력 상한에 포함되므로 낮게 유지
# OpenAI 의 비추론 모델(gpt-4.1-mini 등)은 이 값을 받지 않으므로 비워둘 것
LLM_REASONING_EFFORT=none
#
# OpenAI 예시
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_REASONING_EFFORT=

# --- n8n ---
# 크리덴셜 암호화 키. 한 번 정하면 바꾸지 마세요 (바꾸면 저장된 크리덴셜을 못 읽음)
N8N_ENCRYPTION_KEY=change-me-32chars-random-string

# --- Grafana ---
GF_ADMIN_PASSWORD=admin
