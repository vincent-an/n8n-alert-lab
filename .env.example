# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 .gitignore 대상입니다.

# --- GitHub (코드 permalink / 런북 링크) ---
GITHUB_OWNER=your-github-id
GITHUB_REPO=n8n-alert-lab

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
APP_DB_PASSWORD=change-me-app
DIAG_DB_PASSWORD=change-me-diag
OPS_DB_PASSWORD=change-me-ops

# --- Slack Incoming Webhook ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# --- n8n ---
# 크리덴셜 암호화 키. 한 번 정하면 바꾸지 마세요 (바꾸면 저장된 크리덴셜을 못 읽음)
N8N_ENCRYPTION_KEY=change-me-32chars-random-string

# --- Grafana ---
GF_ADMIN_PASSWORD=admin
